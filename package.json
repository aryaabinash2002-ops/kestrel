{
  "name": "kestrel",
  "version": "0.1.0",
  "description": "Kestrel \u2014 real-time AI interview & call copilot",
  "main": "./out/main/index.js",
  "author": "Kestrel",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/kestrel-app/kestrel",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:ext": "tsc --noEmit -p extension/tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:ext",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:ext": "node scripts/build-extension.mjs",
    "package:mac": "npm run prepackage && electron-vite build && electron-builder --mac",
    "package:win": "npm run prepackage && electron-vite build && electron-builder --win",
    "package:all": "npm run prepackage && electron-vite build && electron-builder --mac --win",
    "postinstall": "electron-builder install-app-deps",
    "build:icons": "node scripts/make-icons.mjs build && node -e \"import('./scripts/make-icons.mjs').then(m=>require('fs').writeFileSync('build/icon.png', m.iconPng(1024)))\"",
    "prepackage": "npm run build:ext",
    "package:dir": "npm run prepackage && electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "^13.0.3",
    "keytar": "^7.9.0",
    "mammoth": "^1.12.2",
    "pdf-parse": "^2.4.5",
    "ws": "^8.21.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/chrome": "^0.2.9",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lucide-react": "^1.44.0",
    "prettier": "^3.9.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "electron@44.3.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "keytar@7.9.0": true
  }
}
